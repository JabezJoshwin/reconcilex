# Copy to .env and supply your own local password. Never commit .env.
DB_PASSWORD=
# Optional host port overrides if defaults are already in use.
DB_PORT=5432
APP_PORT=8080
# Create a Clerk application; the publishable key is public, not a secret.
# CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
APP_BASE_URL=http://localhost:8080
# Use production only behind the documented trusted HTTPS proxy.
SPRING_PROFILES_ACTIVE=
